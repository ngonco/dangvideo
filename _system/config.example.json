  "cleanup": {
    "auto_cleanup": true,
    "retention_days": 2
  },
  "browser": {
    "headless": false,
    "user_data_dir": "browser_profiles/default"
  },
  "schedule_publish": {
    "enabled": true,
    "default_time": "10:00",
    "target_date": "tomorrow"
  },
  "custom_caption": {
    "prefix_text": "",
    "append_text": ""
  }
