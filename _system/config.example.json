{
  "hatbuinho": {
    "url": "https://hatbuinho.com/",
    "username": "",
    "password": "",
    "auto_login": true
  },
  "platforms": {
    "youtube": {
      "enabled": true,
      "privacy": "public",
      "mark_ai": true,
      "name": "YouTube Shorts"
    },
    "tiktok": {
      "enabled": true,
      "privacy": "public",
      "mark_ai": true,
      "name": "TikTok"
    },
    "facebook": {
      "enabled": true,
      "privacy": "public",
      "target_type": "professional_dashboard",
      "page_name": "",
      "mark_ai": true,
      "name": "Facebook Reels"
    },
    "instagram": {
      "enabled": true,
      "privacy": "public",
      "share_to_feed": false,
      "mark_ai": true,
      "min_gap_hours": 3,
      "name": "Instagram Reels"
    }
  },
  "schedule": {
    "auto_mode": true,
    "max_posts_per_day": 3,
    "post_time_slots": [
      "08:00",
      "11:30",
      "19:30"
    ],
    "scan_interval_minutes": 60,
    "min_delay_between_posts_minutes": 180
